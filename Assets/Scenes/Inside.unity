  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "We had no choice. With the resupply plane gone, the supplies wouldn\u2019t
    have lasted. If you're reading this... you're on your own.\n\nThe cold is too
    harsh with your current gear, but there\u2019s a 5-minute window on the surface
    at noon. Use it wisely. Scavenge what you can from the wreckage.\n\nDon\u2019t
    forget your duties \u2014 keep the generators running in the morning and evening,
    or you\u2019ll freeze.\n\nRation your food. Stretch your fuel. And... forgive
    us.\n\n\u2014 Dr. Keller & Jones"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
